{
  "rules": {
    ".read": false,
    ".write": false,
    "beds": {
      ".read": "auth != null",
      "$bedId": {
        ".write": "auth != null && auth.token.device === true && auth.uid === $bedId",
        ".validate": "newData.hasChildren(['weightGrams', 'flowRateMlPerHr', 'bottlePercentRemaining', 'bottleEmpty', 'lastUpdated'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 48"
        },
        "label": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "ward": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "weightGrams": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "flowRateMlPerHr": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000"
        },
        "dropsPerMin": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
        },
        "bottlePercentRemaining": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "bottleEmpty": {
          ".validate": "newData.isBoolean()"
        },
        "heartRate": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250"
        },
        "spo2": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "sensorOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastUpdated": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "severity": {
          ".validate": "newData.isString() && newData.val().matches(/^(normal|caution|critical)$/)"
        },
        "bed": {
          ".validate": "newData.isString() && newData.val().length <= 48"
        },
        "wifi": {
          ".validate": "newData.isBoolean()"
        },
        "backlog": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "finger": {
          ".validate": "newData.isBoolean()"
        },
        "signal": {
          ".validate": "newData.isString() && newData.val().matches(/^(no-finger|acquiring|ok|motion|offline)$/)"
        },
        "rhythm": {
          ".validate": "newData.isString() && newData.val().matches(/^(regular|irregular|unknown)$/)"
        },
        "irregularProb": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "baselinePct": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "hrLow": {
          ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 200"
        },
        "hrHigh": {
          ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 200"
        },
        "hrOutOfRange": {
          ".validate": "newData.isBoolean()"
        },
        "unresponsive": {
          ".validate": "newData.isBoolean()"
        },
        "unresponsiveWhy": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "fluidMl": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "capacityMl": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 5000"
        },
        "clamp": {
          ".validate": "newData.isString() && newData.val().matches(/^(open|closed|offline)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "history": {
      ".read": "auth != null",
      "$bedId": {
        ".write": "auth != null && auth.token.device === true && auth.uid === $bedId",
        ".indexOn": "t",
        "$sampleId": {
          ".validate": "newData.hasChildren(['t', 'flowRateMlPerHr']) && $sampleId.matches(/^[0-9]{13}$/)",
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "flowRateMlPerHr": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000"
          },
          "bottlePercentRemaining": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "weightGrams": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
          },
          "sensorOnline": {
            ".validate": "newData.isBoolean()"
          },
          "bottleEmpty": {
            ".validate": "newData.isBoolean()"
          },
          "heartRate": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250"
          },
          "spo2": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "irregularProb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "rhythm": {
            ".validate": "newData.isString() && newData.val().matches(/^(regular|irregular|unknown)$/)"
          },
          "unresponsive": {
            ".validate": "newData.isBoolean()"
          },
          "motion": {
            ".validate": "newData.isBoolean()"
          },
          "approxTime": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "ward": {
      ".read": "auth != null",
      ".write": "auth != null",
      "beds": {
        "$bedId": {
          ".validate": "newData.hasChildren(['bedNumber', 'patientId', 'device', 'volumeMl', 'prescribedFlowMlPerHr'])",
          "bedNumber": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "patientId": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "device": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 48"
          },
          "volumeMl": {
            ".validate": "newData.isNumber() && newData.val() >= 50 && newData.val() <= 3000"
          },
          "prescribedFlowMlPerHr": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },
          "lowVolumePct": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 50)"
          },
          "clinician": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)"
          },
          "notes": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 280)"
          },
          "ivStartAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "acks": {
        "$bedId": {
          "kind": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "settings": {
        "lowVolumePct": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
        },
        "flowDeviationPct": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 80"
        },
        "$other": {
          ".validate": false
        }
      },
      "log": {
        "$pushId": {
          ".write": "auth != null && !data.exists()",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "bedId": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "bedLabel": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "severity": {
            ".validate": "newData.isString() && newData.val().matches(/^(critical|caution|normal|offline)$/)"
          },
          "event": {
            ".validate": "newData.isString() && newData.val().matches(/^(acknowledged|assigned|edited|removed)$/)"
          },
          "reason": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
          },
          "by": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
