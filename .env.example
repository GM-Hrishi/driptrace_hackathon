# DripTrace - Firebase web client configuration
#
# Copy this file to .env.local and fill in the values from:
#   Firebase console > Project settings > General > Your apps > Web app > SDK setup
#
# .env.local is gitignored. Never commit a filled-in copy of this file.
# These values identify the Firebase project to the browser; they are NOT access
# control. All real authorization lives in firebase/database.rules.json and
# firebase/firestore.rules, which deny every client write.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database instance URL, e.g. https://driptrace-xxxx.firebaseio.com
# or https://driptrace-xxxx-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# Realtime Database path the ESP32 units publish readings under.
VITE_FIREBASE_BEDS_PATH=beds

# Sign the dashboard in anonymously so Firebase rules can require auth != null
# without judges or ward staff needing to log in. Set to "false" only if you
# wire up a real sign-in flow.
VITE_FIREBASE_ANON_AUTH=true
